# Render settings. A push that changes files in render/ starts the render workflow.

# region file in render/regions/ (name, bounding box, zoom levels, OSM sources)
REGION=tas-mtfield
source "$(dirname "${BASH_SOURCE[0]}")/regions/$REGION.env"

# tiles = full MBTiles file, preview = a few images only (fast)
MODE=preview
# map font (dejavu, noto, roboto, opensans, verdana, trebuchet, helvetica, geometric, swiss)
FONT=trebuchet
# MODE=preview: font variants to compare (one font = overview sheet of all places)
PREVIEW_FONTS=trebuchet
# MODE=preview: places to render: from preview_places.txt or found automatically
# (Zeltplatz, Tor_verschlossen, Pisten, Weg_privat, Pfad_unsichtbar, Aussichtspunkt); empty = all
PREVIEW_PLACES=Pisten,Pisten_4WD,Tor_verschlossen,Trail_Namen_Zoom14
# 2 = 512 px tiles ("@2x", sharp on phones)
SCALE=2
