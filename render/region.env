# Region to render. A push that changes files in render/ starts the render workflow.
NAME=thurgau
TITLE="Thurgau (OpenTopoMap)"
# bounding box: west,south,east,north (WGS84)
BBOX=8.66,47.37,9.51,47.71
MINZOOM=8
MAXZOOM=16
# tiles = full MBTiles file, preview = a few comparison images only (fast)
MODE=preview
# font variant for MODE=tiles (dejavu, noto, roboto, sourcesans, opensans); empty = style default
FONT=
# font variants compared in MODE=preview
PREVIEW_FONTS=helvetica,geometric,swiss,trebuchet
# places from preview_places.txt to render in MODE=preview (empty = all)
PREVIEW_PLACES=Ottenberg,Aussichtspunkt,Pfad_unsichtbar,Weg_privat
# 2 = 512 px tiles ("@2x", sharp on phones)
SCALE=2
# OSM extracts covering the box (Geofabrik); they are clipped and merged
PBF_URLS="https://download.geofabrik.de/europe/switzerland-latest.osm.pbf https://download.geofabrik.de/europe/germany/baden-wuerttemberg/freiburg-regbez-latest.osm.pbf https://download.geofabrik.de/europe/germany/baden-wuerttemberg/tuebingen-regbez-latest.osm.pbf"
