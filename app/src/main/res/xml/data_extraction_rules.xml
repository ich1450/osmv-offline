<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher: keep large offline map files out of cloud backup and device transfer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="maps/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="maps/" />
    </device-transfer>
</data-extraction-rules>
