<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:fitsSystemWindows="false">

    <com.applikationsprogramvara.osmviewer.SnapMapView android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        />

    <com.applikationsprogramvara.osmviewer.UserTouchSurface
        android:id="@+id/userTouchSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        />

    <TextView
        android:id="@+id/tvOutOfScreenDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:background="@drawable/rounded_corner"
        android:padding="3dp"
        />

    <com.applikationsprogramvara.osmviewer.OutOfScreenPointer
        android:id="@+id/outOfScreenPointer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:textViewDistance="@id/tvOutOfScreenDistance"
        />

    <RelativeLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        >

        <include
            layout="@layout/main_buttons_panel"
            android:id="@+id/mainButtons"
            />

        <include
            layout="@layout/aux_buttons_panel"
            android:id="@+id/auxButtons"
            />

        <include
            layout="@layout/text_labels_panel"
            android:id="@+id/textLabelsPanel"
            />

        <!-- bottom left: zoom level and "go to my position" -->
        <LinearLayout
            android:id="@+id/gpsPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_margin="@dimen/screenMargin">

            <TextView
                android:id="@+id/tvZoomLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Z 10"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:shadowColor="#FFFFFFFF"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="0" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnJumpToLocation"
                style="@style/RoundMapButton"
                android:src="@drawable/ic_my_location"
                android:contentDescription="@string/btn_location" />
        </LinearLayout>

        <!-- scale bar from the GPS button to the right edge -->
        <com.applikationsprogramvara.osmviewer.ScaleBarView
            android:id="@+id/scaleBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/scaleBarHeight"
            android:layout_toRightOf="@id/gpsPanel"
            android:layout_toEndOf="@id/gpsPanel"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/screenMargin"
            android:layout_marginRight="@dimen/screenMargin"
            android:layout_marginEnd="@dimen/screenMargin" />

        <include
            layout="@layout/debug_info_panel"
            android:id="@+id/debugLayout"
            />


    </RelativeLayout>

</RelativeLayout>